# HTTP headers for Cloudflare (Workers and Pages; other static hosts ignore this file)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Files with a hash in their name never change
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# Geo data and the sample library change rarely: cache for a week, check again after that
/demo/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/geo/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
